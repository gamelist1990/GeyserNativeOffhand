          ]
        },
        "leftarm": {
          "position": [
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? -13.5 : 0.0",
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? -10.0 : 0.0",
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? 12.0 : 0.0"
          ],
          "rotation": [
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? (95.0 + variable.is_using_vr * 7.5) : 0.0",
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? (45.0 - variable.is_using_vr * 7.5) : 0.0",
            "query.equipped_item_any_tag('slot.weapon.offhand', 'nativeoffhand:vanilla_offhand_pose') ? (-115.0 + variable.is_using_vr * 2.5) : 0.0"
          ]
        }
