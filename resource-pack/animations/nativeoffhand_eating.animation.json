{
  "format_version": "1.10.0",
  "animations": {
    "animation.nativeoffhand.eating.left": {
      "loop": true,
      "animation_length": 120,
      "bones": {
        "leftitem": {
          "position": [
            "(v.is_first_person && !v.is_paperdoll) ? math.min(q.anim_time * 48, 12) : 0",
            "(v.is_first_person && !v.is_paperdoll) ? math.min(q.anim_time * 12, 3) : 0",
            "(v.is_first_person && !v.is_paperdoll) && q.anim_time > 0.25 ? math.sin(q.anim_time * 1440 + 0.5) * 2 : 0"
          ],
          "rotation": [
            "(v.is_first_person && !v.is_paperdoll) ? math.min(q.anim_time * 128, 32) : 0",
            0,
            "(v.is_first_person && !v.is_paperdoll) ? -math.min(q.anim_time * 384, 96) : 0"
          ]
        }
      }
    }
  }
}
