{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.nativeoffhand.food": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "wield"
          ],
          "transitions": [
            {
              "eat": "variable.noh_mode == 1"
            },
            {
              "drink": "variable.noh_mode == 2"
            }
          ]
        },
        "eat": {
          "animations": [
            "wield",
            {
              "eat": "context.is_first_person"
            }
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "idle": "variable.noh_mode != 1"
            }
          ]
        },
        "drink": {
          "animations": [
            "wield",
            {
              "drink": "context.is_first_person"
            }
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "idle": "variable.noh_mode != 2"
            }
          ]
        }
      }
    }
  }
}
