{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "nativeoffhand:melon_slice",
      "item": {
        "nativeoffhand:melon_slice": "query.owner_identifier == 'minecraft:player' && context.item_slot == 'off_hand'"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/melon",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.nativeoffhand.food"
      },
      "animations": {
        "consume_controller": "controller.animation.nativeoffhand.food",
        "wield": "animation.nativeoffhand.food.wield",
        "eat": "animation.nativeoffhand.food.eat",
        "drink": "animation.nativeoffhand.food.drink"
      },
      "scripts": {
        "pre_animation": [
          "variable.noh_mode = query.property('nativeoffhand:consume_mode');"
        ],
        "animate": [
          "consume_controller"
        ]
      },
      "render_controllers": [
        "controller.render.nativeoffhand.food"
      ]
    }
  }
}
