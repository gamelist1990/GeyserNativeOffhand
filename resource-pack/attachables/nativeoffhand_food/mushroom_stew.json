{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "nativeoffhand:mushroom_stew",
      "item": {
        "nativeoffhand:mushroom_stew": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/mushroom_stew",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.nativeoffhand.food.main",
        "offhand": "geometry.nativeoffhand.food.offhand"
      },
      "animations": {
        "consume_controller": "controller.animation.nativeoffhand.food",
        "wield": "animation.nativeoffhand.food.wield",
        "eat": "animation.nativeoffhand.food.eat",
        "drink": "animation.nativeoffhand.food.drink"
      },
      "scripts": {
        "pre_animation": [
          "variable.noh_left = context.item_slot == 'off_hand';",
          "variable.noh_mode = variable.noh_left ? query.property('nativeoffhand:consume_mode') : 0;"
        ],
        "animate": [
          "consume_controller"
        ]
      },
      "render_controllers": [
        "controller.render.nativeoffhand.food"
      ]
    }
  }
}
